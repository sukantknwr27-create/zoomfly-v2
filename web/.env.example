# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-only (used later for bookings, payments, cron). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Razorpay (Dashboard -> Settings -> API keys; use TEST keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay -> Webhooks: set any secret you like here and the same one in the dashboard
RAZORPAY_WEBHOOK_SECRET=
# Protects /api/cron/*; Vercel Cron sends it automatically. Use a long random string.
CRON_SECRET=

# Email via Resend (resend.com): verify your sending domain there, then create an API key
RESEND_API_KEY=
EMAIL_FROM=ZoomFly <hello@zoomfly.in>
# where YOU get alerts (new seller, trip waiting for review, dispute, overdue balance). Comma-separate several.
ADMIN_NOTIFY_EMAIL=
# optional: where customers' replies go
EMAIL_REPLY_TO=

# Public site settings
NEXT_PUBLIC_SITE_URL=https://zoomfly.in
NEXT_PUBLIC_CONTACT_EMAIL=
# 1 on staging / Vercel previews so search engines never index them. Leave unset in production.
NEXT_PUBLIC_NOINDEX=
# Set to "final" ONLY after your lawyer has approved the legal pages. Until then they show a draft banner and stay out of search.
NEXT_PUBLIC_LEGAL_STATUS=draft
