# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-only (used later for bookings, payments, cron). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Razorpay (Dashboard -> Settings -> API keys; use TEST keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay -> Webhooks: set any secret you like here and the same one in the dashboard
RAZORPAY_WEBHOOK_SECRET=
# Protects /api/cron/*; Vercel Cron sends it automatically. Use a long random string.
CRON_SECRET=
